generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Media {
  id            String            @id @default(cuid())
  path          String            @unique
  filename      String
  mimeType      String
  size          Int?
  defaultAlt    String            @default("")
  storage       String            @default("upload")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  aboutSections AboutSection[]
  blogCovers    BlogPost[]
  blogSections  BlogSection[]
  services      FeaturedService[]

  @@map("media")
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  coverId        String
  coverAlt       String        @default("")
  status         String        @default("draft")
  seoTitle       String        @default("")
  seoDescription String        @default("")
  publishedAt    DateTime?
  cover          Media         @relation(fields: [coverId], references: [id], onDelete: Restrict)
  sections       BlogSection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([coverId])
  @@map("blog_posts")
}

model BlogSection {
  id        String   @id @default(cuid())
  postId    String
  type      String
  content   String   @default("")
  mediaId   String?
  imageAlt  String   @default("")
  caption   String   @default("")
  sortOrder Int      @default(0)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([postId, sortOrder])
  @@index([mediaId])
  @@map("blog_sections")
}

model ContactSettings {
  id        String   @id
  email     String
  phone     String
  phoneHref String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_settings")
}

model SiteSettings {
  id                     String   @id
  bookingWidgetCode      String   @default("")
  maintenanceModeEnabled Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("site_settings")
}

model SocialLink {
  id        String   @id
  label     String
  href      String
  icon      String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("social_links")
}

model FaqSection {
  id        String    @id
  title     String
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  items     FaqItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visible, sortOrder])
  @@map("faq_sections")
}

model FaqItem {
  id        String     @id
  sectionId String
  question  String
  answer    String
  visible   Boolean    @default(true)
  sortOrder Int        @default(0)
  section   FaqSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sectionId, visible, sortOrder])
  @@map("faq_items")
}

model AboutPage {
  id        String         @id
  sections  AboutSection[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("about_pages")
}

model AboutSection {
  id        String    @id @default(cuid())
  pageId    String
  title     String
  text      String
  mediaId   String
  imageAlt  String    @default("")
  sortOrder Int       @default(0)
  page      AboutPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([pageId, sortOrder])
  @@index([mediaId])
  @@map("about_sections")
}

model HomePage {
  id             String   @id
  introText      String
  marqueeEnabled Boolean  @default(true)
  marqueeText    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("home_pages")
}

model NavigationItem {
  path      String   @id
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("navigation_items")
}

model Review {
  id        String   @id
  videoUrl  String
  name      String
  subtitle  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("reviews")
}

model FeaturedService {
  id            String               @id
  timelineLabel String
  variant       String
  title         String
  subtitle      String
  price         String
  actionLabel   String
  imageId       String?
  imageAlt      String               @default("")
  sortOrder     Int                  @default(0)
  image         Media?               @relation(fields: [imageId], references: [id], onDelete: SetNull)
  waveform      ServiceWaveformBar[]
  features      ServiceFeature[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([sortOrder])
  @@index([imageId])
  @@map("featured_services")
}

model ServiceWaveformBar {
  id        String          @id @default(cuid())
  serviceId String
  value     Int
  sortOrder Int             @default(0)
  service   FeaturedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_waveform_bars")
}

model ServiceFeature {
  id        String          @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int             @default(0)
  service   FeaturedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_features")
}

model PriceListPage {
  id        String             @id
  title     String
  subtitle  String
  sections  PriceListSection[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("price_list_pages")
}

model PriceListSection {
  id        String          @id
  pageId    String
  title     String
  subtitle  String
  sortOrder Int             @default(0)
  page      PriceListPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items     PriceListItem[]

  @@index([pageId, sortOrder])
  @@map("price_list_sections")
}

model PriceListItem {
  id         String               @id
  sectionId  String
  title      String
  subtitle   String
  price      String
  unit       String
  sortOrder  Int                  @default(0)
  section    PriceListSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  variations PriceListVariation[]

  @@index([sectionId, sortOrder])
  @@map("price_list_items")
}

model PriceListVariation {
  id        String        @id
  itemId    String
  title     String
  price     String
  sortOrder Int           @default(0)
  item      PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("price_list_variations")
}

model DataMigration {
  id        String   @id
  appliedAt DateTime @default(now())

  @@map("data_migrations")
}
